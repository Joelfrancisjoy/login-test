PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
NODE_ENV=development
# Google Cloud Console -> OAuth 2.0 Web Client ID (same value in frontend/.env)
GOOGLE_CLIENT_ID=
# Set SMTP values to send real verification emails; without these the server prints a local test link
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Inventory Marketplace <no-reply@example.com>"
